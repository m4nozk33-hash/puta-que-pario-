{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "esnext"], "jsx": "preserve", "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "incremental": true, "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
